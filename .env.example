# 이 파일을 `.env` 로 복사해 값을 채운다. `.env` 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# 네 프로세스가 같은 파일을 읽는다. 명령줄에 키를 적으면 셸 히스토리와 ps 에 남는다.

# ── VLM 물체 판정 ──────────────────────────────────────────────────────
# 없으면 판정이 전부 실패한다. 시연에 반드시 필요하다.
VLM_PROVIDER=openai
OPENAI_API_KEY=
# 비전 모델. 바꾸면 판정 정확도를 다시 재야 한다 —
# 지금 기록된 20/20 은 다른 모델에서 잰 값이다.
OPENAI_MODEL=gpt-4o-mini
# 사내 게이트웨이 등을 쓸 때만.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── STT 음성 인식 (선택) ───────────────────────────────────────────────
# 없으면 voice_service 가 "듣기 꺼짐" 으로 돈다. 세션은 그대로 완결된다.
STT_PROVIDER=clova
CLOVA_SPEECH_SECRET=
# 콘솔의 도메인 Invoke URL 이 기본값과 다르면 여기에 적는다.
# CLOVA_SPEECH_URL=https://clovaspeech-gw.ncloud.com/recog/v1/stt?lang=Kor

# ── TTS 발화 생성 (시연 전 1회) ────────────────────────────────────────
# tools/render_lines.py 가 wav 를 미리 만들 때만 쓴다. 실행 중에는 필요 없다.
HUMELO_API_KEY=
